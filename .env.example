# Copy the two existing public values from your project's .env; keep the same database.
# Both must be set BEFORE npm run build. Never put a secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional runtime overrides. Normally leave unset on self-hosting.
# If provided, use the SAME database URL and publishable (not admin) key as above.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Set in the host settings or when building locally:
# Netlify: NITRO_PRESET=netlify
# Vercel: NITRO_PRESET=vercel
# Generic Node server: NITRO_PRESET=node-server
# NITRO_PRESET=

# No service-role key, password, Lovable API key, project ID, or migration URL
# is required to run the feedback form and dashboard.